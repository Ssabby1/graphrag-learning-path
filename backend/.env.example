# Copy this file to .env and fill with your real values.
APP_NAME=KG Learning Path Backend
APP_VERSION=0.2.0
API_PREFIX=
CORS_ORIGINS=*

# Public default: runs the complete sample chain without Neo4j.
GRAPH_BACKEND=csv
GRAPH_CONCEPTS_CSV=../data/seed/concepts.csv
GRAPH_RELATIONS_CSV=../data/seed/relations.csv

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# Cross-platform graph safety and in-process snapshot cache.
GRAPH_MAX_NODES=2000
GRAPH_MAX_EDGES=10000
GRAPH_QUERY_TIMEOUT_SECONDS=10
GRAPH_CACHE_TTL_SECONDS=60

# Multilingual retrieval. Model download is opt-in so tests and first startup stay offline.
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_ALLOW_DOWNLOAD=false
EMBEDDING_FALLBACK_BACKEND=unicode_hashing
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_DIR=.cache/embeddings
RETRIEVAL_MODE=hybrid_rrf
RETRIEVAL_TOP_K_VECTOR=8
RETRIEVAL_TOP_K_FINAL=6
RETRIEVAL_RRF_K=60
# Cross-encoder is loaded only when RETRIEVAL_MODE=hybrid_rrf_rerank.
RERANKER_BACKEND=cross_encoder
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_ALLOW_DOWNLOAD=false
RERANKER_FALLBACK_BACKEND=token_overlap
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
# Leave empty for automatic device selection; use cpu if MPS has compatibility issues.
RERANKER_DEVICE=
EVIDENCE_TOP_K=8
TARGET_RESOLVER_TOP_K=5
TARGET_RESOLVER_MIN_SCORE=0.8
TARGET_RESOLVER_MIN_MARGIN=0.01

# Optional structured Answer Generator. Disabled/missing credentials always use bilingual fallback.
LLM_ENABLED=false
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Backward-compatible aliases if older scripts still read OPENAI_* or MINIMAX_*.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_MODEL=
MINIMAX_BASE_URL=

LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
